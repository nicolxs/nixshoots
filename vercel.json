{
  "version": 2,
  "name": "nixshoots-cms",
  "builds": [
    {
      "src": "**/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/storage/(.*)",
      "dest": "/storage/$1"
    },
    {
      "src": "/api\\.php",
      "dest": "/api.php"
    },
    {
      "src": "/admin\\.php",
      "dest": "/admin.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "VERCEL": "1"
  },
  "functions": {
    "*.php": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
